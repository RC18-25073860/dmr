# 本地运行配置示例；本文件不自动加载，按说明使用 shell export。
# 默认数据目录为项目内 data/；任何自定义本地路径必须位于项目目录内。
DMR_PORT=8920
DMR_DATA_DIR=data
DMR_AUTH_MODE=local
DMR_ENV=local

# 本地默认只允许本机访问；后期统一部署时由反向代理负责HTTPS。
# 生产环境必须显式填写实际访问域名和完整来源，不能使用*通配。
DMR_BIND_HOST=127.0.0.1
DMR_ALLOWED_HOSTS=127.0.0.1,localhost,127.0.0.1:8920,localhost:8920
DMR_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost,http://127.0.0.1:8920,http://localhost:8920
DMR_PUBLIC_ORIGIN=
DMR_COOKIE_SECURE=false

# 本地空库允许首次创建管理员；生产部署必须为false，并先在受控本机初始化或导入管理员。
DMR_SETUP_ALLOWED=true

# 当前 local 模式使用数据库中的本地账号登录，登录后由 HttpOnly Cookie 维持会话。
# 首次空库启动时在页面创建本地管理员；演示约定可使用“佳佳”作为显示名称，但不是固定写死账号。
# 管理员登录信息后续由启动/初始化流程保存到 .runtime/本地管理员登录信息.txt，注意不要外发。

# 兼容旧配置字段：当前 server.py 不再把它们作为当前用户或权限来源。
# 如旧脚本读取这些变量，保留即可；不要用它们判断接口权限。
DMR_LOCAL_USER=local-user
DMR_LOCAL_ROLES=admin

# DATABASE_URL 暂不设置。默认由 DMR_DATA_DIR 生成 SQLite URL。
# 当前本地版不会连接尚未确认的企业数据库。
# 统一登录、ERP、PLM、邮件、企业通知中心及远程文件存储均未接入。

# 192接入（默认留空：页面显示未接入，不启动真实同步）
# 平台与内网程序令牌值必须一致；不要把真实值写进此模板。
DMR_NAS_SYNC_TOKEN=
DMR_NAS_READ_BASE_URL=
# Fernet密钥：正式环境应由受控配置提供并独立备份。
# 本地未提供时首次保存账号生成 data/nas-credentials.key（不回显）。
DMR_NAS_CREDENTIALS_KEY=
# DMR转移清单专用归档根目录（指向含Y-2026等年度目录的父目录）；未配置时只保存到平台并待重试。
DMR_TRANSFER_ARCHIVE_MOUNT_ROOT=
# 内网程序部署和证书说明见 nas_agent/README.md。

# 飞书目录读取：在每台需要刷新目录的机器上配置，不要提交真实 token。
DMR_FEISHU_ROOT_TOKEN=
DMR_FEISHU_HOST=https://example.feishu.cn
# 转移清单在界面中显示的网络路径；真实写入位置由上面的挂载路径决定。
DMR_TRANSFER_ARCHIVE_NETWORK_ROOT=\\nas.example.local\文档中心\DMR转移清单
