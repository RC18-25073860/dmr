DMR_ENV=production
DMR_AUTH_MODE=local
DMR_PORT=8920
DMR_BIND_HOST=127.0.0.1
DMR_ALLOWED_HOSTS=dmr.example.com
DMR_TRUSTED_ORIGINS=https://dmr.example.com
DMR_PUBLIC_ORIGIN=https://dmr.example.com
DMR_COOKIE_SECURE=true
DMR_SETUP_ALLOWED=false
DMR_DATA_DIR=data
# Generate and retain a Fernet key separately; never include real secrets in a release.
DMR_NAS_CREDENTIALS_KEY=REPLACE_WITH_PRIVATE_KEY

# Must equal DMR_NAS_WORKER_TOKEN in nas.env.
DMR_NAS_SYNC_TOKEN=REPLACE_WITH_PRIVATE_TOKEN
DMR_NAS_READ_BASE_URL=https://nas-reader.example.com:8910
