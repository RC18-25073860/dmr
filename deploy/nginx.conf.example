# Replace domain/certificate paths, validate with nginx -t before enabling.
server {
    listen 443 ssl;
    server_name dmr.example.com;
    ssl_certificate /etc/ssl/dmr/fullchain.pem;
    ssl_certificate_key /etc/ssl/dmr/privkey.pem;
    client_max_body_size 80m;
    location / {
        proxy_pass http://127.0.0.1:8920;
        proxy_set_header Host $host;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
}
server {
    listen 80;
    server_name dmr.example.com;
    return 301 https://$host$request_uri;
}
